# Copy this file to .streamlit/secrets.toml and fill in what you use.
# Every key is OPTIONAL: without any keys the app still works (built-in LinkedIn source + keyword extractor).
# Never commit secrets.toml — it is in .gitignore.

# AI extraction (more accurate). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
# GEMINI_MODEL = "gemini-flash-latest"

# Adzuna job API. Free key: https://developer.adzuna.com
ADZUNA_APP_ID = ""
ADZUNA_APP_KEY = ""

# Apify (paid). Token: https://console.apify.com/settings/integrations
APIFY_API_TOKEN = ""
# APIFY_ACTOR_ID = "bebity/linkedin-jobs-scraper"
